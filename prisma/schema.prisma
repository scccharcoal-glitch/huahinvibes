generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

model Place {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  type        String
  status      String    @default("draft")
  featured    Boolean   @default(false)

  description String?
  content     String?
  excerpt     String?

  address     String?
  area        String?
  lat         Float?
  lng         Float?
  googlePlaceId String?

  cuisine     String?
  priceRange  String?
  openingHours String?

  hotelType   String?
  starRating  Int?

  category    String?

  phone       String?
  website     String?
  email       String?
  bookingUrl  String?

  coverImage  String?
  images      String?

  seoTitle    String?
  seoDesc     String?
  tags        String?

  rating      Float?    @default(0)
  reviewCount Int?      @default(0)
  reviewsJson String?
  viewCount   Int?      @default(0)

  linkedPlaces String?   // JSON: [{slug, review}] for listicle blog posts

  publishedAt DateTime?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([type, status])
  @@index([area])
  @@index([slug])
}
