{
  "name": "nextjs-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "postinstall": "prisma generate",
    "seed": "npx ts-node --project tsconfig.json prisma/seed.ts",
    "db:seed": "node --loader ts-node/esm prisma/seed.ts",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate deploy",
    "import:agoda:hotels": "npx ts-node --compiler-options '{\"module\":\"CommonJS\"}' prisma/import-agoda-hotels.ts"
  },
  "prisma": {
    "seed": "npx ts-node --compiler-options '{\"module\":\"CommonJS\"}' prisma/seed.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.5.0",
